# Copier vers .env.local pour le développement local (jamais commiter .env.local)
# Sur Vercel : Project Settings → Environment Variables

STRIPE_SECRET_KEY=sk_test_xxxx
PUBLIC_SITE_URL=http://localhost:3000

# Protège /admin (voir api/admin-gate.js) — choisir un identifiant et un mot
# de passe fort. Tant que ces deux variables ne sont pas définies sur Vercel,
# /admin reste bloqué pour tout le monde.
ADMIN_USERNAME=
ADMIN_PASSWORD=
